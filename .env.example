# Copy this file to .env and fill in your own values.
# .env is gitignored, so real keys never get committed.

# Required for RAG chain-of-thought generation (src/agents/rag_agent.py).
# Without it, RAG falls back to extractive synthesis (no LLM call).
OPENAI_API_KEY=

# Optional: raises HuggingFace Hub rate limits when downloading NER/sentiment models.
HF_TOKEN=
